flowchart TB
    subgraph P1["一期｜人工核账 + Pro CRM / Max 受控 SQL"]
        direction TB
        P1A["用户点击<br/>I have transferred"] --> P1B["服务端按 order_id<br/>幂等记录 notice"]
        P1B --> P1C["机器人向指定 Lark 群<br/>发送消息卡片并自动 @财务<br/>同一订单只发一次"]
        P1C --> P1D["财务按附言 + 金额<br/>核对银行真实入账"]
        P1D --> P1O{"本单等级"}

        P1O -->|"Pro 订单"| P1E["财务在同一群消息/线程<br/>@越南销售负责人"]
        P1E --> P1F["越南销售复用现有 CRM<br/>按本单天数开通 Pro"]
        P1F --> P1G{"当前权益"}
        P1G -->|"非会员 / 已过期"| P1H["Pro 从 now 起算"]
        P1G -->|"有效 Pro"| P1I["Pro 从原到期日顺延"]
        P1G -->|"有效 Max"| P1X["禁止跨等级升降级<br/>转异常处理"]
        P1H --> P1J["开通完成<br/>进入 C 端等待页"]
        P1I --> P1J

        P1O -->|"Max 订单"| M1["通知授权技术人员"]
        M1 --> M2["手动执行受控 SQL<br/>校验 order_id / user / 订单等级"]
        M2 --> M3["幂等保护 + 事务执行"]
        M3 --> M4{"当前权益"}
        M4 -->|"非会员 / 已过期"| M5["从 now 创建 Max"]
        M4 -->|"有效 Max"| M6["Max 从原到期日顺延"]
        M4 -->|"有效 Pro"| P1X
        M5 --> M7["执行后回查<br/>会员等级 + expire_at"]
        M6 --> M7
        M7 --> P1J

        P1J --> P1K["等待页携带 order_id<br/>调用状态接口"]
        P1K --> P1K1["服务端按 order_id 定位订单、<br/>绑定 user_id 与开通前快照<br/>防止串单"]
        P1K1 --> P1K2["用订单绑定的 user_id 定位用户<br/>手机号仅作账号匹配 / 兜底"]
        P1K2 --> P1K3["读取该用户当前会员等级 + expire_at<br/>不轮询 grant / opening 记录"]
        P1K3 --> P1K4{"下单前快照 × 本单等级"}
        P1K4 -->|"无有效会员"| P1K5{"当前已变为本单等级<br/>且会员有效？"}
        P1K4 -->|"同等级有效会员"| P1K6{"等级仍与本单一致，且 expire_at<br/>已按本单天数顺延？"}
        P1K4 -->|"跨等级有效会员"| P1X
        P1K5 -->|"是"| P1L["Membership opened<br/>+ Download App"]
        P1K5 -->|"否，继续轮询"| P1K
        P1K6 -->|"是"| P1L
        P1K6 -->|"否，继续轮询"| P1K
    end

    subgraph P1RULE["一期边界"]
        direction LR
        R1["notice 不代表到账"]
        R2["群消息不代表到账"]
        R3["不在 CRM 新增<br/>银行转账记录视图 / Tab"]
        R4["Pro：越南销售复用现有 CRM"]
        R5["Max：授权技术人员手动受控 SQL"]
        R6["禁止 Pro / Max 跨等级升降级"]
    end

    subgraph P2["二期｜CRM Max / SKU 测试通过后上线"]
        direction TB
        P2A["CRM Max / SKU 功能<br/>即使开发完成也不发布生产"] --> P2B{"测试是否通过？"}
        P2B -->|"否"| P2H["继续沿用一期流程"]
        P2B -->|"是"| P2C["作为二期发布生产"]
        P2C --> P2D["CRM 读取本单 SKU"]
        P2D --> P2E{"当前有效付费会员"}
        P2E -->|"无"| P2F["按 SKU 发 Pro / Max"]
        P2E -->|"有效 Pro + Pro SKU"| P2G["仅续 Pro"]
        P2E -->|"有效 Max + Max SKU"| P2I["仅续 Max"]
        P2E -->|"有效 Pro + Max SKU<br/>或有效 Max + Pro SKU"| P2X["禁止跨等级升降级<br/>转异常处理"]
        P2F --> P2J["按 order_id 写入 grant<br/>同一订单只发一次"]
        P2G --> P2J
        P2I --> P2J
    end

    P1L -.->|"后续能力演进"| P2A

    classDef phase1 fill:#EAF2FF,stroke:#2563EB,color:#102A56,stroke-width:2px;
    classDef phase2 fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:2px;
    classDef rule fill:#FFF7E6,stroke:#D97706,color:#7C2D12,stroke-width:2px;
    classDef exception fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px;
    class P1A,P1B,P1C,P1D,P1O,P1E,P1F,P1G,P1H,P1I,P1J,M1,M2,M3,M4,M5,M6,M7,P1K,P1K1,P1K2,P1K3,P1K4,P1K5,P1K6,P1L phase1;
    class P2A,P2B,P2C,P2D,P2E,P2F,P2G,P2H,P2I,P2J phase2;
    class R1,R2,R3,R4,R5,R6 rule;
    class P1X,P2X exception;
