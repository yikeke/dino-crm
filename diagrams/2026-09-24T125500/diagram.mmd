flowchart TB
    subgraph P1["一期｜人工核账 + 现有 CRM 发 Pro"]
        direction TB
        P1A["用户点击<br/>I have transferred"] --> P1B["服务端按 order_id<br/>幂等记录 notice"]
        P1B --> P1C["机器人向指定 Lark 群<br/>发送消息卡片并自动 @财务<br/>同一订单只发一次"]
        P1C --> P1D["财务按附言 + 金额<br/>核对银行真实入账"]
        P1D --> P1E["财务在同一群消息/线程<br/>@越南销售负责人"]
        P1E --> P1F["销售使用现有 CRM<br/>按天数添加 Pro"]
        P1F --> P1G{"当前权益"}
        P1G -->|"非会员 / 已过期"| P1H["Pro 从 now 起算"]
        P1G -->|"有效 Pro"| P1I["Pro 从原到期日顺延"]
        P1G -->|"有效 Max"| P1X["禁止添加 Pro<br/>转异常处理"]
        P1H --> P1J["写入本单 grant"]
        P1I --> P1J
        P1J --> P1K["C 端轮询本单状态"]
        P1K --> P1L["Membership opened<br/>+ Download App"]
    end

    subgraph P1RULE["一期边界"]
        direction LR
        R1["notice 不代表到账"]
        R2["群消息不代表到账"]
        R3["不新增银行转账 Tab"]
        R4["不支持 Max 银行转账"]
    end

    subgraph P2["二期｜按本单 SKU 发 Pro / Max"]
        direction TB
        P2A["CRM 读取本单 SKU"] --> P2B{"当前有效付费会员"}
        P2B -->|"无"| P2C["按 SKU 发 Pro / Max"]
        P2B -->|"有效 Pro + Pro SKU"| P2D["仅续 Pro"]
        P2B -->|"有效 Max + Max SKU"| P2E["仅续 Max"]
        P2B -->|"有效 Pro + Max SKU<br/>或有效 Max + Pro SKU"| P2X["暂不支持升降级<br/>转异常处理"]
        P2C --> P2F["按 order_id 写入 grant<br/>同一订单只发一次"]
        P2D --> P2F
        P2E --> P2F
    end

    P1L -.->|"后续能力演进"| P2A

    classDef phase1 fill:#EAF2FF,stroke:#2563EB,color:#102A56,stroke-width:2px;
    classDef phase2 fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:2px;
    classDef rule fill:#FFF7E6,stroke:#D97706,color:#7C2D12,stroke-width:2px;
    classDef exception fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px;
    class P1A,P1B,P1C,P1D,P1E,P1F,P1G,P1H,P1I,P1J,P1K,P1L phase1;
    class P2A,P2B,P2C,P2D,P2E,P2F phase2;
    class R1,R2,R3,R4 rule;
    class P1X,P2X exception;
